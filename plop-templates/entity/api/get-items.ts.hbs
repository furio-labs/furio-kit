import 'server-only'
import { z } from 'zod'
import { env } from '@/shared/env'
import { {{pascalCase name}}Schema } from '../model/types'

const {{pascalCase name}}sResponseSchema = z.array({{pascalCase name}}Schema)

// Call from request-time code only (e.g. after `await connection()` in an async
// Server Component) so results are never prerendered at build time.
export async function get{{pascalCase name}}s() {
  // Server-only variable: NEXT_PUBLIC_* would inline the backend URL into browser bundles.
  const apiUrl = env.API_URL

  if (!apiUrl) {
    if (env.NODE_ENV === 'production') {
      throw new Error('API_URL is not set; refusing to serve mock {{name}}s in production.')
    }
    // TODO: replace with real dev mock data
    return {{pascalCase name}}sResponseSchema.parse([])
  }

  const res = await fetch(`${apiUrl}/{{name}}s`, { next: { revalidate: 60 } })
  if (!res.ok) throw new Error(`Failed to fetch {{name}}s: ${res.status}`)
  return {{pascalCase name}}sResponseSchema.parse(await res.json())
}
