# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=my-app
NEXT_PUBLIC_APP_DESCRIPTION=Enterprise React boilerplate by FurioLabs

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Base URL for the backend REST API. Server-only: read in entities/*/api via
# @/shared/env, never inlined into browser bundles (no NEXT_PUBLIC_ prefix).
# Unset in development → local mock data. Unset in production → data requests
# fail with an error (mock data is never served in production).
# API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Auth secrets — NEVER use NEXT_PUBLIC_ prefix for secrets
# ---------------------------------------------------------------------------
# AUTH_SECRET=change-me-in-production

# This app's public origin; Auth0/Ping adapters build the OIDC callback URL from it.
# APP_BASE_URL=http://localhost:3000

# Auth0 (AUTH_PROVIDER=auth0; requires `pnpm add @auth0/nextjs-auth0`)
# AUTH0_DOMAIN=your-tenant.auth0.com
# AUTH0_CLIENT_ID=your-client-id
# AUTH0_CLIENT_SECRET=your-client-secret

# PingFederate / PingOne (AUTH_PROVIDER=ping; requires `pnpm add jose`)
# PING_ISSUER=https://your-ping-instance.com
# PING_CLIENT_ID=your-client-id
# PING_CLIENT_SECRET=your-client-secret

# ---------------------------------------------------------------------------
# Auth provider selection
# ---------------------------------------------------------------------------
# auth0 | ping | mock (default: mock). Selects the adapter loaded by
# src/shared/auth/server.ts; no code change needed to switch.
# mock is for development only: under NODE_ENV=production it authenticates
# nobody (every protected route redirects to /login) and logs an error.
AUTH_PROVIDER=mock

# ---------------------------------------------------------------------------
# Dev convenience
# ---------------------------------------------------------------------------
# With AUTH_PROVIDER=mock, set to any non-empty value to get a mock admin
# session in development. Ignored in production.
# MOCK_AUTH_USER=1
